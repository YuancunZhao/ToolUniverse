{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tooluniverse.org/schemas/acmg-evidence-compatibility.schema.json",
  "title": "ToolUniverse ACMG Evidence Compatibility Resolution",
  "$comment": "This schema validates field shape only. Hard-stop invariants, such as unresolved_conflicts requiring draft classification and blocking Bayesian posterior calculation, are enforced by overlay_route_contract.md and evals/evals.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "classification_status",
    "current_counted_evidence_resolved",
    "not_used_due_to_overlap",
    "caps_applied",
    "context_splits",
    "unresolved_conflicts",
    "resolutions"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "classification_status": {
      "type": "string",
      "enum": ["final classification", "draft classification"]
    },
    "current_counted_evidence_resolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "not_used_due_to_overlap": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "caps_applied": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capItem"
      }
    },
    "context_splits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextSplit"
      }
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resolutionItem"
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resolutionItem"
      }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "evidence_label", "reason"],
      "properties": {
        "criterion": {
          "type": "string",
          "pattern": "^[A-Z0-9_/+-]+$"
        },
        "evidence_label": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": ["pathogenic", "benign", "context", "unknown"]
        },
        "strength": {
          "type": "string"
        },
        "route_outcome": {
          "type": "string",
          "enum": [
            "overlay_applied",
            "overlay_not_applicable",
            "overlay_not_assessed",
            "overlay_deferred_to_vcep"
          ]
        },
        "consumed_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolutionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_group",
        "evidence_items",
        "conflict_type",
        "resolution",
        "kept_evidence",
        "removed_or_capped_evidence",
        "reason",
        "status"
      ],
      "properties": {
        "conflict_group": {
          "type": "string",
          "minLength": 1
        },
        "evidence_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "conflict_type": {
          "type": "string",
          "enum": [
            "hard_incompatibility",
            "same_primary_evidence",
            "mechanism_mismatch",
            "context_split_required",
            "cap_required",
            "source_provenance_block",
            "unresolved"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "keep_more_specific",
            "keep_primary_evidence",
            "keep_mechanism_appropriate",
            "drop_as_not_used",
            "cap_combined_strength",
            "split_by_context",
            "defer_to_vcep",
            "unresolved_draft_only"
          ]
        },
        "kept_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "removed_or_capped_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "no_evidence",
            "not_assessed",
            "not_applicable",
            "not_used"
          ]
        }
      }
    },
    "capItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cap_name", "affected_evidence", "maximum_contribution", "reason"],
      "properties": {
        "cap_name": {
          "type": "string",
          "minLength": 1
        },
        "affected_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "maximum_contribution": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contextSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split_axis", "evidence_sets", "reason"],
      "properties": {
        "split_axis": {
          "type": "string",
          "enum": ["disease", "inheritance", "mechanism", "transcript", "other"]
        },
        "evidence_sets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context_label", "evidence"],
            "properties": {
              "context_label": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidenceItem"
                }
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
