{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tooluniverse.org/schemas/acmg-overlay-route-plan.schema.json",
  "title": "ToolUniverse ACMG Overlay Route Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "route_plan"],
  "properties": {
    "version": {
      "type": "string"
    },
    "route_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_criteria",
          "required_overlays",
          "trigger_policy",
          "applies_when",
          "baseline_data_sources",
          "reason_for_routing",
          "vcep_deferred"
        ],
        "properties": {
          "candidate_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_/+-]+$"
            }
          },
          "criterion_group": {
            "type": "string"
          },
          "required_overlays": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^tooluniverse-acmg-[a-z0-9-]+$"
            }
          },
          "trigger_policy": {
            "type": "string",
            "enum": [
              "universal_baseline",
              "variant_type_baseline",
              "evidence_discovery"
            ]
          },
          "applies_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "baseline_data_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "reason_for_routing": {
            "type": "string",
            "minLength": 1
          },
          "candidate_trigger": {
            "type": "string"
          },
          "vcep_deferred": {
            "type": "boolean"
          },
          "vcep_source": {
            "type": ["string", "null"]
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    }
  }
}
