{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tooluniverse.org/schemas/acmg-route-audit.schema.json",
  "title": "ToolUniverse ACMG Route Audit",
  "$comment": "This schema validates field shape only. Hard-stop invariants, such as counted evidence requiring overlay_applied or overlay_deferred_to_vcep before final classification, are enforced by overlay_route_contract.md and evals/evals.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "classification_status", "items"],
  "properties": {
    "version": {
      "type": "string"
    },
    "classification_status": {
      "type": "string",
      "enum": ["final classification", "draft classification"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "proposed_evidence",
          "route_outcome",
          "guidance_authority",
          "overlay_or_vcep_source",
          "counted",
          "reason"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "pattern": "^[A-Z0-9_/+-]+$"
          },
          "proposed_evidence": {
            "type": "string",
            "minLength": 1
          },
          "route_outcome": {
            "type": "string",
            "enum": [
              "overlay_applied",
              "overlay_not_applicable",
              "overlay_not_assessed",
              "overlay_deferred_to_vcep"
            ]
          },
          "trigger_policy": {
            "type": "string",
            "enum": [
              "universal_baseline",
              "variant_type_baseline",
              "evidence_discovery"
            ]
          },
          "applies_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guidance_authority": {
            "type": "string",
            "enum": [
              "ClinGen/SVI primary",
              "ACMG/AMP baseline",
              "VCEP-specific",
              "practice/local refinement",
              "source lead only"
            ]
          },
          "overlay_or_vcep_source": {
            "type": "string",
            "minLength": 1
          },
          "counted": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "consumed_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "literature_provenance": {
            "$ref": "#/$defs/literatureProvenance"
          }
        }
      }
    }
  },
  "$defs": {
    "literatureProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_text_status",
        "supplement_status",
        "figure_status",
        "counted_evidence_allowed",
        "reason"
      ],
      "properties": {
        "pmid": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "full_text_status": {
          "type": "string",
          "enum": [
            "full_text_read",
            "abstract_only",
            "source_unavailable",
            "not_needed"
          ]
        },
        "supplement_status": {
          "type": "string",
          "enum": [
            "supplement_read",
            "unavailable",
            "not_needed"
          ]
        },
        "figure_status": {
          "type": "string",
          "enum": [
            "figure_readable",
            "not_interpretable",
            "not_needed"
          ]
        },
        "counted_evidence_allowed": {
          "type": "boolean"
        },
        "vcep_allows_abstract_level_use": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
