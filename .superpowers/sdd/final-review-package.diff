+        "criterion": criterion,
+        "strength": strength,
+        "lower": lower,
+        "upper": upper,
+        "lower_inclusive": lower_inclusive,
+        "upper_inclusive": upper_inclusive,
+    }
+
+
+CALIBRATED_INTERVALS: dict[str, list[dict[str, Any]]] = {
