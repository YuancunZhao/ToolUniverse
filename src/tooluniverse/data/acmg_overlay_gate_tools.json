[
  {
    "name": "ACMG_evidence_collector",
    "description": "Primary ToolUniverse ACMG evidence collector for germline variant review. Accepts transcript HGVS, gene;transcript:c. HGVS, genomic HGVS/VCF-like input, rsID, gene plus c. shorthand, or gene plus p. HGVS. Coding shorthand is resolved through VariantValidator MANE transcript tools; protein shorthand is resolved through Ensembl VEP and then MANE projection, with ambiguity failing closed. This tool collects and displays evidence from ToolUniverse data sources and deterministic ClinGen/SVI overlay logic for user judgment. It does not automatically produce final ACMG/AMP classifications, does not adopt ClinVar, GeneBe, InterVar, or other source labels as criteria, and reports conflicts and Bayesian estimates as review aids only.",
    "type": "ACMG_evidence_collector",
    "parameter": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "description": "Transcript HGVS, gene;transcript:c. HGVS, genomic HGVS/VCF-like variant, rsID, gene plus c. shorthand, or gene plus p. HGVS, e.g. NM_000142.5:c.1075+95C>G, BRCA2;NM_000059.4:c.5946delT, rs80359550, BRCA2 c.5946delT, or BRCA2 p.Ser1982ArgfsTer22. Coding shorthand uses VariantValidator MANE resolution; protein shorthand uses Ensembl VEP followed by MANE projection."
        },
        "gene": {
          "type": "string",
          "description": "Gene symbol, if known."
        },
        "transcript": {
          "type": "string",
          "description": "Transcript accession or transcript context, if known."
        },
        "disease": {
          "type": "string",
          "description": "Disease name or MONDO identifier used to match an applicable ClinGen CSpec."
        },
        "inheritance": {
          "type": "string",
          "description": "Inheritance mode used to match an applicable ClinGen CSpec."
        },
        "genome_build": {
          "type": "string",
          "enum": ["GRCh38", "GRCh37", "hg38", "hg19"],
          "description": "Genome assembly. hg19/hg38 normalize to GRCh37/GRCh38; coordinate inputs without an explicit or accession-inferred build fail closed."
        },
        "source_outputs_or_leads": {
          "type": "array",
          "description": "Existing outputs from GeneBe, InterVar, ClinVar, ClinGen, SpliceAI, MyVariant, VEP, papers, labs, or other tools. These are normalized as source leads, not automatically included in the system preview.",
          "items": {}
        },
        "literature_proposals": {
          "type": "array",
          "description": "Preferred host-LLM literature proposal input generated after executing literature_review requests. Each proposal includes a fact type, full-text locator and excerpt, structured facts, interpretation, confidence, extractor version, unresolved questions, and a section/table/figure-aware reading manifest. Criterion and strength are optional LLM suggestions; ToolUniverse independently enforces the fact-type mapping after re-fetching and verifying the document.",
          "items": {
            "type": "object",
            "properties": {
              "fact_id": {"type": "string", "minLength": 1},
              "fact_type": {"type": "string", "enum": ["case_control", "case_series", "de_novo", "pm3", "recessive_allelic", "functional", "segregation", "phenotype_specificity", "healthy_observation", "allelic_phase", "alternative_cause", "prior_variant", "mechanism", "region_hotspot", "protein_length_repeat", "rna_splicing"]},
              "pmid": {"type": "string"},
              "pmcid": {"type": "string"},
              "doi": {"type": "string"},
              "review_request_id": {"type": "string"},
              "document_hash": {"type": "string"},
              "locator": {"type": "string", "minLength": 1},
              "excerpt": {"type": "string", "minLength": 1},
              "variant_identity": {"type": "string", "minLength": 1},
              "gene": {"type": "string", "minLength": 1},
              "values": {"type": "object"},
              "field_excerpts": {
                "type": "object",
                "additionalProperties": {"type": "string", "minLength": 1}
              },
              "criterion": {"type": "string", "minLength": 1},
              "suggested_strength": {"type": "string", "minLength": 1},
              "interpretation": {"type": "string", "minLength": 1},
              "confidence": {"type": ["number", "string"]},
              "questions": {"type": "array", "items": {"type": "string"}},
              "reading_manifest": {
                "type": "object",
                "properties": {
                  "status": {"type": "string", "enum": ["complete", "partial", "abstract_only", "unavailable"]},
                  "sections_read": {"type": "array", "items": {"type": "string"}},
                  "tables_read": {"type": "array", "items": {"type": "string"}},
                  "figures_read": {"type": "array", "items": {"type": "string"}},
                  "supplements_read": {"type": "array", "items": {"type": "string"}},
                  "variant_match_locations": {"type": "array", "items": {"type": "string"}},
                  "limitations": {"type": "array", "items": {"type": "string"}}
                },
                "required": ["status"],
                "additionalProperties": false
              },
              "extractor": {
                "type": "object",
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1}
                },
                "required": ["name", "version"],
                "additionalProperties": false
              }
            },
            "required": ["fact_id", "fact_type", "locator", "excerpt", "variant_identity", "gene", "values", "field_excerpts", "interpretation", "confidence", "extractor"],
            "anyOf": [{"required": ["pmid"]}, {"required": ["pmcid"]}],
            "additionalProperties": false
          }
        },
        "cspec_proposals": {
          "type": "array",
          "description": "Host-LLM interpretations of natural-language rules from the uniquely matched online ClinGen CSpec. ToolUniverse re-fetches the specification and verifies ID, version, content hash, criterion and excerpt before use.",
          "items": {
            "type": "object",
            "properties": {
              "specification_id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "content_hash": {"type": "string", "minLength": 1},
              "criterion": {"type": "string", "minLength": 1},
              "locator": {"type": "string"},
              "excerpt": {"type": "string", "minLength": 1},
              "structured_interpretation": {"type": "object"},
              "suggested_strength": {"type": "string", "minLength": 1},
              "interpretation": {"type": "string", "minLength": 1},
              "confidence": {"type": ["number", "string"]},
              "extractor": {
                "type": "object",
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1}
                },
                "required": ["name", "version"],
                "additionalProperties": false
              }
            },
            "required": ["specification_id", "version", "content_hash", "criterion", "excerpt", "structured_interpretation", "suggested_strength", "interpretation", "confidence", "extractor"],
            "additionalProperties": false
          }
        },
        "evidence_decisions": {
          "type": "array",
          "description": "User decisions applied only to stable card IDs regenerated in this call. Accept or reject a card; an accepted card may use a direction-consistent standard strength override when a reason is supplied.",
          "items": {
            "type": "object",
            "properties": {
              "card_id": {"type": "string", "minLength": 1},
              "decision": {"type": "string", "enum": ["accept", "reject"]},
              "strength_override": {"type": "string", "minLength": 1},
              "reason": {"type": "string"},
              "reviewer": {"type": "string"},
              "decided_at": {"type": "string"}
            },
            "required": ["card_id", "decision"],
            "additionalProperties": false
          }
        },
        "protein_accession": {
          "type": "string"
        },
        "clinical_context": {
          "type": "object",
          "description": "Review-only clinical context. Explicit HPO terms trigger term/gene/disease lookups; all matches remain PP4 review context and never generate PP4 automatically.",
          "properties": {
            "zygosity": {"type": "string"},
            "parental_origin": {"type": "string"},
            "phase": {"type": "string"},
            "phenotype": {"type": ["string", "array"]},
            "second_allele_status": {"type": "string"},
            "hpo_terms": {
              "type": "array",
              "items": {"type": "string"},
              "description": "HPO identifiers in HP:0001250, HP_0001250, or bare numeric form."
            }
          },
          "additionalProperties": true
        },
        "response_detail": {
          "type": "string",
          "enum": ["summary", "full"],
          "default": "summary",
          "description": "Output detail level. 'summary' (default) returns compact source-fact/evidence-card indexes plus ID/decision-only compatibility, Bayesian, and criterion-review reports; 'full' returns complete audit payloads."
        }
      },
      "required": [
        "variant"
      ],
      "additionalProperties": false
    },
    "fields": {
      "operation": "collect_evidence"
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "degraded",
            "error",
            "not_applicable"
          ]
        },
        "execution_status": {"type": "string"},
        "coverage_status": {"type": "string"},
        "variant": {
          "type": "object"
        },
        "variant_identity": {"type": "object"},
        "variant_scope": {
          "type": "object",
          "description": "Pre-provider build and small-variant/SV scope decision."
        },
        "clinical_context": {
          "type": ["object", "null"],
          "description": "Review-only clinical context echo; never evidence."
        },
        "consequence_profile": {
          "type": "object",
          "description": "Identity-bound, multi-provider selected-transcript consequence profile used for criterion applicability routing.",
          "properties": {
            "annotation_status": {"type": "string", "enum": ["resolved", "empty", "unavailable", "identity_conflict"]},
            "attempted_representations": {"type": "array", "items": {"type": "object"}},
            "annotation_reason": {"type": "string"},
            "observations": {"type": "array", "items": {"type": "object"}},
            "selected_provider": {"type": "string"},
            "selected_source_fact_ids": {"type": "array", "items": {"type": "string"}},
            "corroborating_source_fact_ids": {"type": "array", "items": {"type": "string"}},
            "provider_failures": {"type": "array", "items": {"type": "object"}},
            "provider_conflicts": {"type": "array", "items": {"type": "object"}},
            "resolution_reason": {"type": "string"},
            "transcript_mapping": {"type": "object"},
            "selected_observation": {"type": ["object", "null"]},
            "missing_requirements": {"type": "array", "items": {"type": "string"}},
            "hgvs_operation": {"type": "string"},
            "splice_positions": {"type": "array", "items": {"type": "integer"}},
            "canonical_site_type": {"type": "string", "enum": ["donor", "acceptor", "ambiguous", "none"]},
            "canonical_motif_effect": {"type": "string", "enum": ["disrupted", "potentially_preserved", "unknown", "not_applicable"]},
            "canonical_motif_effect_reason": {"type": "string"},
            "canonical_motif_sequence_status": {"type": "string", "description": "REF/ALT or HGVS sequence-level motif status; functional native-site loss is reported separately in spliceai_profile."},
            "canonical_motif_sequence_reason": {"type": "string"},
            "genomic_position": {"type": ["integer", "null"]},
            "genomic_ref": {"type": "string"},
            "genomic_alt": {"type": "string"}
          }
        },
        "rule_context": {"type": "object"},
        "runtime_manifest": {
          "type": "object",
          "description": "Installed runtime, collector schema, deterministic ruleset hash, VCS provenance when available, and applicable dynamic CSpec identities."
        },
        "guard_context": {
          "type": "object",
          "description": "Compact self-checking EvidenceCard and SourceFact provenance contract for ACMG_guard_final_answer. context_hash detects truncation or accidental mutation; it is not a digital signature."
        },
        "coverage_summary": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source_facts": {
          "type": "array",
          "description": "Normalized provider or document facts supporting reviewable EvidenceCards and system-preview inclusion.",
          "items": {"type": "object"}
        },
        "source_assertions": {"type": "array", "items": {"type": "object"}},
        "prior_variant_candidates": {
          "type": "array",
          "description": "Same-residue germline-compatible prior-variant leads. Database labels remain review-only until independently anchored literature facts validate PS1 or PM5.",
          "items": {"type": "object"}
        },
        "literature_candidates": {
          "type": "array",
          "description": "Cross-provider deduplicated literature index preserving all LitVar, Europe PMC, and PubMed source hits.",
          "items": {"type": "object"}
        },
        "literature_review": {
          "type": "object",
          "description": "Deduplicated candidates, verified full-text state, executable host-LLM review requests, reading manifests, and proposal validation status."
        },
        "recoverable_gaps": {"type": "array", "items": {"type": "object"}},
        "workflow_status": {
          "type": "string",
          "enum": ["collecting", "input_correction_required", "unsupported_variant_class", "consequence_recovery_required", "literature_review_required", "proposal_validation_required", "evidence_ready", "blocked_external_full_text"]
        },
        "review_readiness": {
          "type": "object",
          "description": "Auditable evidence-review readiness. This is workflow completeness, not a five-tier classification."
        },
        "next_actions": {"type": "array", "items": {"type": "object"}},
        "predictor_scores": {"type": "object"},
        "criterion_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {"type": "string"},
              "route_status": {"type": "string", "enum": ["assessed", "proposal_validated", "candidate_available", "review_pending", "insufficient_information", "not_applicable", "deprecated"]},
              "candidate_source_fact_ids": {"type": "array", "items": {"type": "string"}},
              "pending_request_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "evidence_cards": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conflict_report": {
          "type": "object"
        },
        "compatibility_report": {"type": "object"},
        "system_preview_bayesian": {"type": "object"},
        "validated_subset_bayesian": {"type": "object"},
        "user_selected_bayesian": {"type": "object"},
        "decision_report": {"type": "object"},
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_classification_allowed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "status",
        "execution_status",
        "coverage_status",
        "variant",
        "variant_identity",
        "variant_scope",
        "consequence_profile",
        "rule_context",
        "runtime_manifest",
        "guard_context",
        "coverage_summary",
        "source_facts",
        "source_assertions",
        "prior_variant_candidates",
        "literature_candidates",
        "literature_review",
        "recoverable_gaps",
        "workflow_status",
        "review_readiness",
        "next_actions",
        "predictor_scores",
        "criterion_reviews",
        "evidence_cards",
        "conflict_report",
        "compatibility_report",
        "system_preview_bayesian",
        "validated_subset_bayesian",
        "user_selected_bayesian",
        "decision_report",
        "limitations",
        "final_classification_allowed"
      ]
    }
  },
