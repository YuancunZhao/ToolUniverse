    "parameter": {
      "type": "object",
      "properties": {
        "case_control_facts": {
          "type": "array",
          "description": "Standalone review facts. They remain outside the system preview until collector full-text verification.",
          "items": {
            "type": "object",
            "properties": {
              "fact_id": {"type": "string", "minLength": 1},
              "source_pmid": {"type": "string"},
              "source_pmcid": {"type": "string"},
              "section_locator": {"type": "string", "minLength": 1},
              "variant_identity": {},
              "gene": {"type": "string"},
              "case_count": {"type": "integer", "minimum": 1},
              "control_count": {"type": "integer", "minimum": 1},
              "odds_ratio": {"type": "number"},
              "ci_lower": {"type": "number"},
              "phenotype_consistent": {"type": "boolean"},
              "cases_independent": {"type": "boolean"},
              "extraction_method": {"type": "string"}
            },
            "required": [
              "fact_id",
              "section_locator",
              "variant_identity",
              "case_count",
              "control_count",
              "odds_ratio",
              "ci_lower",
              "phenotype_consistent",
              "cases_independent"
            ],
            "additionalProperties": false
          }
        },
        "expected_variant": {
          "type": "string",
          "description": "Variant identity used to bind standalone structured facts."
        },
