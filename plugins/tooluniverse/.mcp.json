{
  "mcpServers": {
    "tooluniverse": {
      "command": "uvx",
      "args": [
        "--refresh",
        "--from",
        "git+https://github.com/YuancunZhao/ToolUniverse.git@07973c6a372acf95aa8b85fcdcdc41ba15efd2e2",
        "tooluniverse"
